# ocamlcc top-level build pipeline (ninja).
#
#   1. vendor/qbe  -> build/qbe/qbe
#   2. runtime/    -> build/rt/libocamlrt.a
#   3. dune        -> build/bin/ocamlcc
#   4. examples/*.ml -> .ssa (ocamlcc) -> .s (qbe) -> native executable (cc)

builddir = build
cc = cc
qbe_dir = vendor/qbe

qbe_cflags = -std=c99 -O2 -g -Wall -Wextra -Wpedantic
rt_cflags = -std=c11 -O2 -g -fPIC -Wall -Wextra

rule cc_qbe
  command = $cc $qbe_cflags -c $in -o $out -I$builddir/qbe
  description = CC $out

rule gen_config
  command = sh tools/gen-config.sh > $out
  description = GEN $out

rule link_qbe
  command = $cc $in -o $out
  description = LINK $out

rule cc_rt
  command = $cc $rt_cflags -Iruntime -c $in -o $out
  description = CC $out

rule ar
  command = ar rcs $out $in
  description = AR $out

rule dune_ocamlcc
  command = dune build bin/ocamlcc && mkdir -p $builddir/bin && rm -f $out && cp _build/default/bin/ocamlcc $out
  description = DUNE ocamlcc
  pool = console

rule ocamlcc_cmi
  command = $builddir/bin/ocamlcc compile-mli $flags $in -o $out
  description = CMIC $out

rule ocamlcc_ssa
  command = $builddir/bin/ocamlcc compile $flags $in -o $out
  description = OCAMLCC $out

rule qbe_ssa
  command = $builddir/qbe/qbe $in > $out
  description = QBE $out

rule cc_link
  command = $cc $in -o $out
  description = LINK $out

rule as_obj
  command = $cc -c $in -o $out
  description = AS $out

rule run
  command = $in && echo "--- smoke: $in OK"
  pool = console
  description = RUN $in

# ---------------------------------------------------------------- QBE ----

qbe_common = main util parse abi cfg mem ssa alias load copy fold gvn gcm simpl ifopt live spill rega emit

build $builddir/qbe/config.h: gen_config

build $builddir/qbe/main.o:    cc_qbe $qbe_dir/main.c    | $qbe_dir/all.h $qbe_dir/ops.h $builddir/qbe/config.h
build $builddir/qbe/util.o:    cc_qbe $qbe_dir/util.c    | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/parse.o:   cc_qbe $qbe_dir/parse.c   | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/abi.o:     cc_qbe $qbe_dir/abi.c     | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/cfg.o:     cc_qbe $qbe_dir/cfg.c     | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/mem.o:     cc_qbe $qbe_dir/mem.c     | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/ssa.o:     cc_qbe $qbe_dir/ssa.c     | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/alias.o:   cc_qbe $qbe_dir/alias.c   | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/load.o:    cc_qbe $qbe_dir/load.c    | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/copy.o:    cc_qbe $qbe_dir/copy.c    | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/fold.o:    cc_qbe $qbe_dir/fold.c    | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/gvn.o:     cc_qbe $qbe_dir/gvn.c     | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/gcm.o:     cc_qbe $qbe_dir/gcm.c     | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/simpl.o:   cc_qbe $qbe_dir/simpl.c   | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/ifopt.o:   cc_qbe $qbe_dir/ifopt.c   | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/live.o:    cc_qbe $qbe_dir/live.c    | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/spill.o:   cc_qbe $qbe_dir/spill.c   | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/rega.o:    cc_qbe $qbe_dir/rega.c    | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/emit.o:    cc_qbe $qbe_dir/emit.c    | $qbe_dir/all.h $qbe_dir/ops.h

build $builddir/qbe/amd64/targ.o:   cc_qbe $qbe_dir/amd64/targ.c   | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/amd64/all.h
build $builddir/qbe/amd64/sysv.o:   cc_qbe $qbe_dir/amd64/sysv.c   | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/amd64/all.h
build $builddir/qbe/amd64/isel.o:   cc_qbe $qbe_dir/amd64/isel.c   | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/amd64/all.h
build $builddir/qbe/amd64/emit.o:   cc_qbe $qbe_dir/amd64/emit.c   | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/amd64/all.h
build $builddir/qbe/amd64/winabi.o: cc_qbe $qbe_dir/amd64/winabi.c | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/amd64/all.h

build $builddir/qbe/arm64/targ.o: cc_qbe $qbe_dir/arm64/targ.c | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/arm64/all.h
build $builddir/qbe/arm64/abi.o:  cc_qbe $qbe_dir/arm64/abi.c  | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/arm64/all.h
build $builddir/qbe/arm64/isel.o: cc_qbe $qbe_dir/arm64/isel.c | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/arm64/all.h
build $builddir/qbe/arm64/emit.o: cc_qbe $qbe_dir/arm64/emit.c | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/arm64/all.h

build $builddir/qbe/rv64/targ.o: cc_qbe $qbe_dir/rv64/targ.c | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/rv64/all.h
build $builddir/qbe/rv64/abi.o:  cc_qbe $qbe_dir/rv64/abi.c  | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/rv64/all.h
build $builddir/qbe/rv64/isel.o: cc_qbe $qbe_dir/rv64/isel.c | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/rv64/all.h
build $builddir/qbe/rv64/emit.o: cc_qbe $qbe_dir/rv64/emit.c | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/rv64/all.h

build $builddir/qbe/qbe: link_qbe $builddir/qbe/main.o $builddir/qbe/util.o $builddir/qbe/parse.o $builddir/qbe/abi.o $builddir/qbe/cfg.o $builddir/qbe/mem.o $builddir/qbe/ssa.o $builddir/qbe/alias.o $builddir/qbe/load.o $builddir/qbe/copy.o $builddir/qbe/fold.o $builddir/qbe/gvn.o $builddir/qbe/gcm.o $builddir/qbe/simpl.o $builddir/qbe/ifopt.o $builddir/qbe/live.o $builddir/qbe/spill.o $builddir/qbe/rega.o $builddir/qbe/emit.o $builddir/qbe/amd64/targ.o $builddir/qbe/amd64/sysv.o $builddir/qbe/amd64/isel.o $builddir/qbe/amd64/emit.o $builddir/qbe/amd64/winabi.o $builddir/qbe/arm64/targ.o $builddir/qbe/arm64/abi.o $builddir/qbe/arm64/isel.o $builddir/qbe/arm64/emit.o $builddir/qbe/rv64/targ.o $builddir/qbe/rv64/abi.o $builddir/qbe/rv64/isel.o $builddir/qbe/rv64/emit.o

# ------------------------------------------------------------ runtime ----

build $builddir/rt/pal.o:      cc_rt runtime/pal.c      | runtime/pal.h
build $builddir/rt/pal_ctx.o:  as_obj runtime/pal_ctx.S
build $builddir/rt/arc.o:      cc_rt runtime/arc.c      | runtime/arc.h runtime/pal.h runtime/fiber.h
build $builddir/rt/closure.o:  cc_rt runtime/closure.c  | runtime/arc.h runtime/pal.h
build $builddir/rt/fiber.o:    cc_rt runtime/fiber.c    | runtime/fiber.h runtime/arc.h runtime/pal.h
build $builddir/rt/builtins.o:   cc_rt runtime/builtins.c
build $builddir/rt/main_entry.o: cc_rt runtime/main_entry.c

build $builddir/rt/libocamlrt.a: ar $builddir/rt/pal.o $builddir/rt/pal_ctx.o $builddir/rt/arc.o $builddir/rt/closure.o $builddir/rt/fiber.o $builddir/rt/builtins.o $builddir/rt/main_entry.o

# ------------------------------------------------------------- ocamlcc ----

build $builddir/bin/ocamlcc: dune_ocamlcc bin/main.ml lib/qbe_il.ml lib/qbe_il.mli lib/frontend.ml lib/frontend.mli lib/builtins.ml lib/builtins.mli lib/anf.ml lib/anf.mli lib/arc_pass.ml lib/arc_pass.mli lib/ccalls.ml lib/ccalls.mli lib/codegen_ctx.ml lib/codegen_analysis.ml lib/codegen_expr.ml lib/codegen_fn.ml lib/codegen.ml lib/codegen.mli lib/pipeline.ml lib/pipeline.mli lib/dune bin/dune dune-project

# ------------------------------------------------------------- stdlib -----

stdlibdir = $builddir/stdlib
stdlib_flags = --nostdlib --nopervasives --mod -I $stdlibdir

build $stdlibdir/camlinternalFormatBasics.ssa | $stdlibdir/camlinternalFormatBasics.cmi: ocamlcc_ssa stdlib/camlinternalFormatBasics.ml | $builddir/bin/ocamlcc
  flags = $stdlib_flags --cmi-prefix $stdlibdir/camlinternalFormatBasics
build $stdlibdir/camlinternalFormatBasics.s: qbe_ssa $stdlibdir/camlinternalFormatBasics.ssa | $builddir/qbe/qbe
build $stdlibdir/camlinternalFormatBasics.o: as_obj $stdlibdir/camlinternalFormatBasics.s

build $stdlibdir/stdlib__option.ssa | $stdlibdir/stdlib__option.cmi: ocamlcc_ssa stdlib/stdlib__option.ml | $builddir/bin/ocamlcc
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__option
build $stdlibdir/stdlib__option.s: qbe_ssa $stdlibdir/stdlib__option.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__option.o: as_obj $stdlibdir/stdlib__option.s

build $stdlibdir/stdlib__result.ssa | $stdlibdir/stdlib__result.cmi: ocamlcc_ssa stdlib/stdlib__result.ml | $builddir/bin/ocamlcc
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__result
build $stdlibdir/stdlib__result.s: qbe_ssa $stdlibdir/stdlib__result.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__result.o: as_obj $stdlibdir/stdlib__result.s

build $stdlibdir/stdlib__bytes.ssa | $stdlibdir/stdlib__bytes.cmi: ocamlcc_ssa stdlib/stdlib__bytes.ml | $builddir/bin/ocamlcc
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__bytes
build $stdlibdir/stdlib__bytes.s: qbe_ssa $stdlibdir/stdlib__bytes.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__bytes.o: as_obj $stdlibdir/stdlib__bytes.s

build $stdlibdir/stdlib__string.ssa | $stdlibdir/stdlib__string.cmi: ocamlcc_ssa stdlib/stdlib__string.ml | $builddir/bin/ocamlcc $stdlibdir/stdlib__bytes.cmi
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__string
build $stdlibdir/stdlib__string.s: qbe_ssa $stdlibdir/stdlib__string.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__string.o: as_obj $stdlibdir/stdlib__string.s

build $stdlibdir/stdlib__list.ssa | $stdlibdir/stdlib__list.cmi: ocamlcc_ssa stdlib/stdlib__list.ml | $builddir/bin/ocamlcc
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__list
build $stdlibdir/stdlib__list.s: qbe_ssa $stdlibdir/stdlib__list.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__list.o: as_obj $stdlibdir/stdlib__list.s

build $stdlibdir/stdlib__array.ssa | $stdlibdir/stdlib__array.cmi: ocamlcc_ssa stdlib/stdlib__array.ml | $builddir/bin/ocamlcc $stdlibdir/stdlib__list.cmi
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__array
build $stdlibdir/stdlib__array.s: qbe_ssa $stdlibdir/stdlib__array.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__array.o: as_obj $stdlibdir/stdlib__array.s

build $stdlibdir/stdlib__buffer.ssa | $stdlibdir/stdlib__buffer.cmi: ocamlcc_ssa stdlib/stdlib__buffer.ml | $builddir/bin/ocamlcc $stdlibdir/stdlib__bytes.cmi $stdlibdir/stdlib__string.cmi
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__buffer
build $stdlibdir/stdlib__buffer.s: qbe_ssa $stdlibdir/stdlib__buffer.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__buffer.o: as_obj $stdlibdir/stdlib__buffer.s

build $stdlibdir/stdlib__hashtbl.ssa | $stdlibdir/stdlib__hashtbl.cmi: ocamlcc_ssa stdlib/stdlib__hashtbl.ml | $builddir/bin/ocamlcc $stdlibdir/stdlib__array.cmi
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__hashtbl
build $stdlibdir/stdlib__hashtbl.s: qbe_ssa $stdlibdir/stdlib__hashtbl.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__hashtbl.o: as_obj $stdlibdir/stdlib__hashtbl.s

build $stdlibdir/stdlib__printf.ssa | $stdlibdir/stdlib__printf.cmi: ocamlcc_ssa stdlib/stdlib__printf.ml | $builddir/bin/ocamlcc $stdlibdir/camlinternalFormatBasics.cmi $stdlibdir/stdlib__bytes.cmi $stdlibdir/stdlib__string.cmi $stdlibdir/stdlib__list.cmi $stdlibdir/stdlib__buffer.cmi
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__printf
build $stdlibdir/stdlib__printf.s: qbe_ssa $stdlibdir/stdlib__printf.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__printf.o: as_obj $stdlibdir/stdlib__printf.s

build $stdlibdir/stdlib__weak.ssa | $stdlibdir/stdlib__weak.cmi: ocamlcc_ssa stdlib/stdlib__weak.ml | $builddir/bin/ocamlcc
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__weak
build $stdlibdir/stdlib__weak.s: qbe_ssa $stdlibdir/stdlib__weak.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__weak.o: as_obj $stdlibdir/stdlib__weak.s

build $stdlibdir/stdlib__fiber.ssa | $stdlibdir/stdlib__fiber.cmi: ocamlcc_ssa stdlib/stdlib__fiber.ml | $builddir/bin/ocamlcc
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__fiber
build $stdlibdir/stdlib__fiber.s: qbe_ssa $stdlibdir/stdlib__fiber.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__fiber.o: as_obj $stdlibdir/stdlib__fiber.s

build $stdlibdir/stdlib.ssa | $stdlibdir/stdlib.cmi: ocamlcc_ssa stdlib/stdlib.ml | $builddir/bin/ocamlcc $stdlibdir/camlinternalFormatBasics.cmi $stdlibdir/stdlib__option.cmi $stdlibdir/stdlib__result.cmi $stdlibdir/stdlib__bytes.cmi $stdlibdir/stdlib__string.cmi $stdlibdir/stdlib__list.cmi $stdlibdir/stdlib__array.cmi $stdlibdir/stdlib__buffer.cmi $stdlibdir/stdlib__hashtbl.cmi $stdlibdir/stdlib__printf.cmi $stdlibdir/stdlib__weak.cmi $stdlibdir/stdlib__fiber.cmi
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib
build $stdlibdir/stdlib.s: qbe_ssa $stdlibdir/stdlib.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib.o: as_obj $stdlibdir/stdlib.s

build $stdlibdir/libocamlstdlib.a: ar $stdlibdir/camlinternalFormatBasics.o $stdlibdir/stdlib__option.o $stdlibdir/stdlib__result.o $stdlibdir/stdlib__bytes.o $stdlibdir/stdlib__string.o $stdlibdir/stdlib__list.o $stdlibdir/stdlib__array.o $stdlibdir/stdlib__buffer.o $stdlibdir/stdlib__hashtbl.o $stdlibdir/stdlib__printf.o $stdlibdir/stdlib__weak.o $stdlibdir/stdlib__fiber.o $stdlibdir/stdlib.o

# ------------------------------------------------------------ examples ----

rule run_test
  command = $builddir/$name > $builddir/$name.out && diff - tests/$name.expected < $builddir/$name.out && echo "PASS $name"
  pool = console
  description = TEST $name

build $builddir/hello.ssa: ocamlcc_ssa examples/hello.ml | $builddir/bin/ocamlcc
build $builddir/hello.s: qbe_ssa $builddir/hello.ssa | $builddir/qbe/qbe
build $builddir/hello: cc_link $builddir/hello.s $builddir/rt/libocamlrt.a

build $builddir/fib.ssa: ocamlcc_ssa examples/fib.ml | $builddir/bin/ocamlcc
build $builddir/fib.s: qbe_ssa $builddir/fib.ssa | $builddir/qbe/qbe
build $builddir/fib: cc_link $builddir/fib.s $builddir/rt/libocamlrt.a

build $builddir/tail.ssa: ocamlcc_ssa examples/tail.ml | $builddir/bin/ocamlcc
build $builddir/tail.s: qbe_ssa $builddir/tail.ssa | $builddir/qbe/qbe
build $builddir/tail: cc_link $builddir/tail.s $builddir/rt/libocamlrt.a

build $builddir/bools.ssa: ocamlcc_ssa examples/bools.ml | $builddir/bin/ocamlcc
build $builddir/bools.s: qbe_ssa $builddir/bools.ssa | $builddir/qbe/qbe
build $builddir/bools: cc_link $builddir/bools.s $builddir/rt/libocamlrt.a

build $builddir/strings.ssa: ocamlcc_ssa examples/strings.ml | $builddir/bin/ocamlcc
build $builddir/strings.s: qbe_ssa $builddir/strings.ssa | $builddir/qbe/qbe
build $builddir/strings: cc_link $builddir/strings.s $builddir/rt/libocamlrt.a

build $builddir/match.ssa: ocamlcc_ssa examples/match.ml | $builddir/bin/ocamlcc
build $builddir/match.s: qbe_ssa $builddir/match.ssa | $builddir/qbe/qbe
build $builddir/match: cc_link $builddir/match.s $builddir/rt/libocamlrt.a

build $builddir/mutual.ssa: ocamlcc_ssa examples/mutual.ml | $builddir/bin/ocamlcc
build $builddir/mutual.s: qbe_ssa $builddir/mutual.ssa | $builddir/qbe/qbe
build $builddir/mutual: cc_link $builddir/mutual.s $builddir/rt/libocamlrt.a

build $builddir/adt.ssa: ocamlcc_ssa examples/adt.ml | $builddir/bin/ocamlcc
build $builddir/adt.s: qbe_ssa $builddir/adt.ssa | $builddir/qbe/qbe
build $builddir/adt: cc_link $builddir/adt.s $builddir/rt/libocamlrt.a

build $builddir/closures.ssa: ocamlcc_ssa examples/closures.ml | $builddir/bin/ocamlcc
build $builddir/closures.s: qbe_ssa $builddir/closures.ssa | $builddir/qbe/qbe
build $builddir/closures: cc_link $builddir/closures.s $builddir/rt/libocamlrt.a

build $builddir/loops.ssa: ocamlcc_ssa examples/loops.ml | $builddir/bin/ocamlcc
build $builddir/loops.s: qbe_ssa $builddir/loops.ssa | $builddir/qbe/qbe
build $builddir/loops: cc_link $builddir/loops.s $builddir/rt/libocamlrt.a

build $builddir/arrays_bytes.ssa: ocamlcc_ssa examples/arrays_bytes.ml | $builddir/bin/ocamlcc
build $builddir/arrays_bytes.s: qbe_ssa $builddir/arrays_bytes.ssa | $builddir/qbe/qbe
build $builddir/arrays_bytes: cc_link $builddir/arrays_bytes.s $builddir/rt/libocamlrt.a

build $builddir/arc_test.ssa: ocamlcc_ssa examples/arc_test.ml | $builddir/bin/ocamlcc
build $builddir/arc_test.s: qbe_ssa $builddir/arc_test.ssa | $builddir/qbe/qbe
build $builddir/arc_test: cc_link $builddir/arc_test.s $builddir/rt/libocamlrt.a

build $builddir/exn.ssa: ocamlcc_ssa examples/exn.ml | $builddir/bin/ocamlcc
build $builddir/exn.s: qbe_ssa $builddir/exn.ssa | $builddir/qbe/qbe
build $builddir/exn: cc_link $builddir/exn.s $builddir/rt/libocamlrt.a

build $builddir/weak_cycle.ssa: ocamlcc_ssa examples/weak_cycle.ml | $builddir/bin/ocamlcc
build $builddir/weak_cycle.s: qbe_ssa $builddir/weak_cycle.ssa | $builddir/qbe/qbe
build $builddir/weak_cycle: cc_link $builddir/weak_cycle.s $builddir/rt/libocamlrt.a

build $builddir/cycle_collect.ssa: ocamlcc_ssa examples/cycle_collect.ml | $builddir/bin/ocamlcc
build $builddir/cycle_collect.s: qbe_ssa $builddir/cycle_collect.ssa | $builddir/qbe/qbe
build $builddir/cycle_collect: cc_link $builddir/cycle_collect.s $builddir/rt/libocamlrt.a

build $builddir/mod_lib.cmi: ocamlcc_cmi examples/mod_lib.mli | $builddir/bin/ocamlcc
build $builddir/mod_lib.ssa: ocamlcc_ssa examples/mod_lib.ml | $builddir/bin/ocamlcc $builddir/mod_lib.cmi
  flags = -I $builddir --cmi-prefix $builddir/mod_lib --mod
build $builddir/mod_lib.s: qbe_ssa $builddir/mod_lib.ssa | $builddir/qbe/qbe

build $builddir/mod_main.ssa: ocamlcc_ssa examples/mod_main.ml | $builddir/bin/ocamlcc $builddir/mod_lib.cmi
  flags = -I $builddir
build $builddir/mod_main.s: qbe_ssa $builddir/mod_main.ssa | $builddir/qbe/qbe
build $builddir/mod_main: cc_link $builddir/mod_main.s $builddir/mod_lib.s $builddir/rt/libocamlrt.a

build $builddir/stdlib_test.ssa: ocamlcc_ssa examples/stdlib_test.ml | $builddir/bin/ocamlcc $stdlibdir/stdlib.cmi
  flags = --nostdlib -I $stdlibdir
build $builddir/stdlib_test.s: qbe_ssa $builddir/stdlib_test.ssa | $builddir/qbe/qbe
build $builddir/stdlib_test: cc_link $builddir/stdlib_test.s $stdlibdir/libocamlstdlib.a $builddir/rt/libocamlrt.a

build $builddir/fiber_test.ssa: ocamlcc_ssa examples/fiber_test.ml | $builddir/bin/ocamlcc $stdlibdir/stdlib.cmi
  flags = --nostdlib -I $stdlibdir
build $builddir/fiber_test.s: qbe_ssa $builddir/fiber_test.ssa | $builddir/qbe/qbe
build $builddir/fiber_test: cc_link $builddir/fiber_test.s $stdlibdir/libocamlstdlib.a $builddir/rt/libocamlrt.a

build $builddir/fiber_io.ssa: ocamlcc_ssa examples/fiber_io.ml | $builddir/bin/ocamlcc $stdlibdir/stdlib.cmi
  flags = --nostdlib -I $stdlibdir
build $builddir/fiber_io.s: qbe_ssa $builddir/fiber_io.ssa | $builddir/qbe/qbe
build $builddir/fiber_io: cc_link $builddir/fiber_io.s $stdlibdir/libocamlstdlib.a $builddir/rt/libocamlrt.a

build smoke: run $builddir/hello

build test_hello: run_test | $builddir/hello
  name = hello
build test_fib: run_test | $builddir/fib
  name = fib
build test_tail: run_test | $builddir/tail
  name = tail
build test_bools: run_test | $builddir/bools
  name = bools
build test_strings: run_test | $builddir/strings
  name = strings
build test_match: run_test | $builddir/match
  name = match
build test_mutual: run_test | $builddir/mutual
  name = mutual
build test_adt: run_test | $builddir/adt
  name = adt
build test_closures: run_test | $builddir/closures
  name = closures
build test_loops: run_test | $builddir/loops
  name = loops
build test_arrays_bytes: run_test | $builddir/arrays_bytes
  name = arrays_bytes
build test_arc_test: run_test | $builddir/arc_test
  name = arc_test
build test_exn: run_test | $builddir/exn
  name = exn
build test_weak_cycle: run_test | $builddir/weak_cycle
  name = weak_cycle
build test_cycle_collect: run_test | $builddir/cycle_collect
  name = cycle_collect
build test_mod_main: run_test | $builddir/mod_main
  name = mod_main
build test_stdlib_test: run_test | $builddir/stdlib_test
  name = stdlib_test
build test_fiber_test: run_test | $builddir/fiber_test
  name = fiber_test
build test_fiber_io: run_test | $builddir/fiber_io
  name = fiber_io

rule qbe_pic_check
  command = $builddir/qbe/qbe -t arm64 $in > $builddir/mod_lib.arm64.s && grep -q ':got:ocamlcc_exn_slot' $builddir/mod_lib.arm64.s && grep -q ':got_lo12:ocamlcc_exn_slot' $builddir/mod_lib.arm64.s && ! grep -E 'adrp[[:space:]]+[^,]+,[[:space:]]*ocamlcc_exn_slot' $builddir/mod_lib.arm64.s && $builddir/qbe/qbe -t amd64_sysv $in > $builddir/mod_lib.amd64.s && grep -q 'ocamlcc_exn_slot@gotpcrel(%rip)' $builddir/mod_lib.amd64.s && grep -q 'callq arc_alloc@plt' $builddir/mod_lib.amd64.s && printf 'export function w $$win_id(w %%x) {\n@start\n\tret %%x\n}\n' | $builddir/qbe/qbe -t amd64_win > $builddir/win_check.s && echo "PASS qbe_pic_check"
  pool = console
  description = PIC-CHECK $in

rule cc_shared
  command = $cc -shared -fPIC $in -o $out
  description = SHARED $out

rule cc_pic_host
  command = $cc -fPIC tests/pic_so_host.c $in -Wl,-rpath,$builddir -o $out
  description = HOST $out

rule run_pic_so
  command = env LD_LIBRARY_PATH=$builddir DYLD_LIBRARY_PATH=$builddir $builddir/pic_so_host > $builddir/pic_so.out && diff - tests/pic_so.expected < $builddir/pic_so.out && echo "PASS pic_so"
  pool = console
  description = TEST pic_so

build $builddir/libmod_lib.so: cc_shared $builddir/mod_lib.s $builddir/rt/libocamlrt.a
build $builddir/pic_so_host: cc_pic_host $builddir/libmod_lib.so | tests/pic_so_host.c
build test_qbe_pic: qbe_pic_check $builddir/mod_lib.ssa | $builddir/qbe/qbe
build test_pic_so: run_pic_so | $builddir/pic_so_host tests/pic_so.expected

build test: phony test_hello test_fib test_tail test_bools test_strings test_match test_mutual test_adt test_closures test_loops test_arrays_bytes test_arc_test test_exn test_weak_cycle test_cycle_collect test_mod_main test_stdlib_test test_fiber_test test_fiber_io test_qbe_pic test_pic_so

rule cc_rt_asan
  command = $cc $rt_cflags -O1 -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -Iruntime -c $in -o $out
  description = CC(ASAN) $out

rule cc_link_asan
  command = $cc -fsanitize=address,undefined -fno-sanitize-recover=all $in -o $out
  description = LINK(ASAN) $out

rule run_asan_test
  command = $builddir/asan/$name > $builddir/asan/$name.out && diff - tests/$name.expected < $builddir/asan/$name.out && echo "PASS(ASAN) $name"
  pool = console
  description = TEST(ASAN) $name

build $builddir/asan/rt/pal.o:      cc_rt_asan runtime/pal.c      | runtime/pal.h
build $builddir/asan/rt/pal_ctx.o:  as_obj     runtime/pal_ctx.S
build $builddir/asan/rt/arc.o:      cc_rt_asan runtime/arc.c      | runtime/arc.h runtime/pal.h runtime/fiber.h
build $builddir/asan/rt/closure.o:  cc_rt_asan runtime/closure.c  | runtime/arc.h runtime/pal.h
build $builddir/asan/rt/fiber.o:    cc_rt_asan runtime/fiber.c    | runtime/fiber.h runtime/arc.h runtime/pal.h
build $builddir/asan/rt/builtins.o:   cc_rt_asan runtime/builtins.c
build $builddir/asan/rt/main_entry.o: cc_rt_asan runtime/main_entry.c

build $builddir/asan/rt/libocamlrt.a: ar $builddir/asan/rt/pal.o $builddir/asan/rt/pal_ctx.o $builddir/asan/rt/arc.o $builddir/asan/rt/closure.o $builddir/asan/rt/fiber.o $builddir/asan/rt/builtins.o $builddir/asan/rt/main_entry.o

build $builddir/asan/adt:           cc_link_asan $builddir/adt.s           $builddir/asan/rt/libocamlrt.a
build $builddir/asan/closures:      cc_link_asan $builddir/closures.s      $builddir/asan/rt/libocamlrt.a
build $builddir/asan/arrays_bytes:  cc_link_asan $builddir/arrays_bytes.s  $builddir/asan/rt/libocamlrt.a
build $builddir/asan/arc_test:      cc_link_asan $builddir/arc_test.s      $builddir/asan/rt/libocamlrt.a
build $builddir/asan/exn:           cc_link_asan $builddir/exn.s           $builddir/asan/rt/libocamlrt.a
build $builddir/asan/weak_cycle:    cc_link_asan $builddir/weak_cycle.s    $builddir/asan/rt/libocamlrt.a
build $builddir/asan/cycle_collect: cc_link_asan $builddir/cycle_collect.s $builddir/asan/rt/libocamlrt.a
build $builddir/asan/mod_main:      cc_link_asan $builddir/mod_main.s $builddir/mod_lib.s $builddir/asan/rt/libocamlrt.a
build $builddir/asan/stdlib_test:   cc_link_asan $builddir/stdlib_test.s   $stdlibdir/libocamlstdlib.a $builddir/asan/rt/libocamlrt.a
build $builddir/asan/fiber_test:    cc_link_asan $builddir/fiber_test.s    $stdlibdir/libocamlstdlib.a $builddir/asan/rt/libocamlrt.a
build $builddir/asan/fiber_io:      cc_link_asan $builddir/fiber_io.s      $stdlibdir/libocamlstdlib.a $builddir/asan/rt/libocamlrt.a

build asan_adt:           run_asan_test | $builddir/asan/adt
  name = adt
build asan_closures:      run_asan_test | $builddir/asan/closures
  name = closures
build asan_arrays_bytes:  run_asan_test | $builddir/asan/arrays_bytes
  name = arrays_bytes
build asan_arc_test:      run_asan_test | $builddir/asan/arc_test
  name = arc_test
build asan_exn:           run_asan_test | $builddir/asan/exn
  name = exn
build asan_weak_cycle:    run_asan_test | $builddir/asan/weak_cycle
  name = weak_cycle
build asan_cycle_collect: run_asan_test | $builddir/asan/cycle_collect
  name = cycle_collect
build asan_mod_main:      run_asan_test | $builddir/asan/mod_main
  name = mod_main
build asan_stdlib_test:   run_asan_test | $builddir/asan/stdlib_test
  name = stdlib_test
build asan_fiber_test:    run_asan_test | $builddir/asan/fiber_test
  name = fiber_test
build asan_fiber_io:      run_asan_test | $builddir/asan/fiber_io
  name = fiber_io

build asan_test: phony asan_adt asan_closures asan_arrays_bytes asan_arc_test asan_exn asan_weak_cycle asan_cycle_collect asan_mod_main asan_stdlib_test asan_fiber_test asan_fiber_io

default $builddir/qbe/qbe $builddir/rt/libocamlrt.a $stdlibdir/libocamlstdlib.a $builddir/bin/ocamlcc $builddir/hello
