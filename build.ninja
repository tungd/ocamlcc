build test_arc_test: run_test | $builddir/arc_test
  name = arc_test
build test_exn: run_test | $builddir/exn
  name = exn
build test_weak_cycle: run_test | $builddir/weak_cycle
  name = weak_cycle
build test_cycle_collect: run_test | $builddir/cycle_collect
