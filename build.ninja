build test_fiber_io: run_test | $builddir/fiber_io
  name = fiber_io

rule qbe_pic_check
  command = $builddir/qbe/qbe -t arm64 $in > $builddir/mod_lib.arm64.s && grep -q ':got:ocamlcc_global_Mod_lib' $builddir/mod_lib.arm64.s && grep -q ':got_lo12:ocamlcc_global_Mod_lib' $builddir/mod_lib.arm64.s && ! grep -E 'adrp[[:space:]]+[^,]+,[[:space:]]*ocamlcc_global_Mod_lib' $builddir/mod_lib.arm64.s && $builddir/qbe/qbe -t amd64_sysv $in > $builddir/mod_lib.amd64.s && grep -q 'ocamlcc_global_Mod_lib@gotpcrel(%rip)' $builddir/mod_lib.amd64.s && grep -q 'callq arc_alloc@plt' $builddir/mod_lib.amd64.s && grep -q 'callq ocamlcc_set_exn@plt' $builddir/mod_lib.amd64.s && printf 'export function w $$win_id(w %%x) {\n@start\n\tret %%x\n}\n' | $builddir/qbe/qbe -t amd64_win > $builddir/win_check.s && echo "PASS qbe_pic_check"
  pool = console
  description = PIC-CHECK $in

rule cc_shared
  command = $cc -shared -fPIC $in -lm -o $out
  description = SHARED $out

rule cc_pic_host
  command = $cc -fPIC tests/pic_so_host.c $in -Wl,-rpath,$builddir -o $out
  description = HOST $out

rule run_pic_so
  command = env LD_LIBRARY_PATH=$builddir DYLD_LIBRARY_PATH=$builddir $builddir/pic_so_host > $builddir/pic_so.out && diff - tests/pic_so.expected < $builddir/pic_so.out && echo "PASS pic_so"
  pool = console
  description = TEST pic_so

build $builddir/libmod_lib.so: cc_shared $builddir/mod_lib.s $builddir/rt/libocamlrt.a
build $builddir/pic_so_host: cc_pic_host $builddir/libmod_lib.so | tests/pic_so_host.c
build test_qbe_pic: qbe_pic_check $builddir/mod_lib.ssa | $builddir/qbe/qbe
build test_pic_so: run_pic_so | $builddir/pic_so_host tests/pic_so.expected

rule cc_mt_host
  command = $cc -O2 -g -pthread tests/mt_ffi_host.c $in -lm -o $out
  description = LINK(MT) $out

rule run_mt_ffi
  command = $builddir/mt_ffi_host > $builddir/mt_ffi.out && diff - tests/mt_ffi.expected < $builddir/mt_ffi.out && echo "PASS mt_ffi"
  pool = console
  description = TEST mt_ffi

build $builddir/mt_ffi_lib.cmi: ocamlcc_cmi examples/mt_ffi_lib.mli | $builddir/bin/ocamlcc $stdlibdir/stdlib.cmi
  flags = --nostdlib -I $stdlibdir
build $builddir/mt_ffi_lib.ssa: ocamlcc_ssa examples/mt_ffi_lib.ml | $builddir/bin/ocamlcc $builddir/mt_ffi_lib.cmi $stdlibdir/stdlib.cmi
  flags = --nostdlib -I $stdlibdir -I $builddir --cmi-prefix $builddir/mt_ffi_lib --mod
build $builddir/mt_ffi_lib.s: qbe_ssa $builddir/mt_ffi_lib.ssa | $builddir/qbe/qbe
build $builddir/mt_ffi_host: cc_mt_host $builddir/mt_ffi_lib.s $stdlibdir/libocamlstdlib.a $builddir/rt/libocamlrt.a | tests/mt_ffi_host.c
build test_mt_ffi: run_mt_ffi | $builddir/mt_ffi_host tests/mt_ffi.expected

build $builddir/tupled_letrec.ssa: ocamlcc_ssa examples/tupled_letrec.ml | $builddir/bin/ocamlcc $stdlibdir/stdlib.cmi
  flags = --nostdlib -I $stdlibdir
build $builddir/tupled_letrec.s: qbe_ssa $builddir/tupled_letrec.ssa | $builddir/qbe/qbe
build $builddir/tupled_letrec: cc_link $builddir/tupled_letrec.s $stdlibdir/libocamlstdlib.a $builddir/rt/libocamlrt.a

build test_tupled_letrec: run_test | $builddir/tupled_letrec
  name = tupled_letrec

build $builddir/primitives_test.ssa: ocamlcc_ssa examples/primitives_test.ml | $builddir/bin/ocamlcc $stdlibdir/stdlib.cmi
  flags = --nostdlib -I $stdlibdir
build $builddir/primitives_test.s: qbe_ssa $builddir/primitives_test.ssa | $builddir/qbe/qbe
build $builddir/primitives_test: cc_link $builddir/primitives_test.s $stdlibdir/libocamlstdlib.a $builddir/rt/libocamlrt.a

build test_primitives_test: run_test | $builddir/primitives_test
  name = primitives_test

rule ocamlcc_bindgen
  command = $builddir/bin/ocamlcc bindgen $flags $in -o $builddir/bindgen_lib.h --shim $builddir/bindgen_lib_shim.c
  description = BINDGEN $in

rule cc_bindgen_host
  command = $cc -std=c99 -O2 -g -Wall -Wextra -Werror -I$builddir $in -lm -o $out
  description = LINK(BINDGEN) $out

rule run_bindgen
  command = $builddir/bindgen_host > $builddir/bindgen.out && diff - tests/bindgen_host.expected < $builddir/bindgen.out && echo "PASS bindgen"
  pool = console
  description = TEST bindgen

build $builddir/bindgen_lib.cmi: ocamlcc_cmi examples/bindgen_lib.mli | $builddir/bin/ocamlcc $stdlibdir/stdlib.cmi
  flags = --nostdlib -I $stdlibdir
build $builddir/bindgen_lib.ssa: ocamlcc_ssa examples/bindgen_lib.ml | $builddir/bin/ocamlcc $builddir/bindgen_lib.cmi $stdlibdir/stdlib.cmi
  flags = --nostdlib -I $stdlibdir -I $builddir --cmi-prefix $builddir/bindgen_lib --mod
build $builddir/bindgen_lib.s: qbe_ssa $builddir/bindgen_lib.ssa | $builddir/qbe/qbe
build $builddir/bindgen_lib.h | $builddir/bindgen_lib_shim.c: ocamlcc_bindgen examples/bindgen_lib.mli | $builddir/bin/ocamlcc $stdlibdir/stdlib.cmi
  flags = --nostdlib -I $stdlibdir
build $builddir/bindgen_host: cc_bindgen_host tests/bindgen_host.c $builddir/bindgen_lib_shim.c $builddir/bindgen_lib.s $stdlibdir/libocamlstdlib.a $builddir/rt/libocamlrt.a | $builddir/bindgen_lib.h
build test_bindgen: run_bindgen | $builddir/bindgen_host tests/bindgen_host.expected

build $builddir/stdlib_runtime: cc_link tests/stdlib_runtime.c $builddir/rt/libocamlrt.a
build test_stdlib_runtime: run_test | $builddir/stdlib_runtime tests/stdlib_runtime.expected
  name = stdlib_runtime

rule run_single_thread_rc_test
  command = python3 tests/check_single_thread_rc.py $builddir/rt-single/single_thread_rc $builddir/rt-single/cycle_collect tests/cycle_collect.expected
  description = TEST single_thread_rc

build $builddir/rt-single/single_thread_rc: cc_link tests/single_thread_rc.c $builddir/rt-single/libocamlrt.a
build $builddir/rt-single/cycle_collect.ssa: ocamlcc_ssa examples/cycle_collect.ml | $builddir/bin/ocamlcc
  flags = --inline-single-thread-rc
build $builddir/rt-single/cycle_collect.s: qbe_ssa $builddir/rt-single/cycle_collect.ssa | $builddir/qbe/qbe
build $builddir/rt-single/cycle_collect: cc_link $builddir/rt-single/cycle_collect.s $builddir/rt-single/libocamlrt.a
build test_single_thread_rc: run_single_thread_rc_test | $builddir/rt-single/single_thread_rc $builddir/rt-single/cycle_collect tests/check_single_thread_rc.py tests/cycle_collect.expected

rule run_native_ffi
  command = $builddir/bin/ocamlcc build --work-dir $builddir/native_ffi-work --stdlib-dir $stdlibdir $in -o $builddir/native_ffi && $builddir/native_ffi
  pool = console
  description = TEST native FFI

build test_native_ffi: run_native_ffi tests/native_ffi/main.ml tests/native_ffi/stubs.c | $builddir/bin/ocamlcc $builddir/qbe/qbe $builddir/rt/libocamlrt.a $stdlibdir/libocamlstdlib.a

rule run_stdlib_opt
  command = sh tests/stdlib_opt/run.sh
  pool = console
  description = TEST stdlib export summaries

build test_stdlib_opt: run_stdlib_opt tests/stdlib_opt/run.sh tests/stdlib_opt/main.ml | $builddir/bin/ocamlcc $builddir/qbe/qbe $builddir/rt/libocamlrt.a $stdlibdir/libocamlstdlib.a.opt

rule run_separate_exports
  command = sh tests/separate_exports/run.sh
  pool = console
  description = TEST separate export summaries

build test_separate_exports: run_separate_exports tests/separate_exports/run.sh tests/separate_exports/provider.ml tests/separate_exports/provider.mli tests/separate_exports/consumer.ml tests/separate_exports/entry.ml | $builddir/bin/ocamlcc $builddir/qbe/qbe $builddir/rt/libocamlrt.a $stdlibdir/libocamlstdlib.a.opt

build test: phony test_stdlib_opt test_separate_exports test_native_ffi test_single_thread_rc test_stdlib_runtime test_hello test_fib test_tail test_bools test_strings test_match test_mutual test_adt test_closures test_loops test_arrays_bytes test_arc_test test_exn test_weak_cycle test_cycle_collect test_mod_main test_stdlib_test test_fiber_test test_fiber_io test_qbe_pic test_pic_so test_mt_ffi test_tupled_letrec test_primitives_test test_bindgen

rule cc_rt_asan
  command = $cc $rt_cflags -O1 -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -Iruntime -c $in -o $out
  description = CC(ASAN) $out

rule cc_link_asan
  command = $cc -fsanitize=address,undefined -fno-sanitize-recover=all -pthread $in -lm -o $out
  description = LINK(ASAN) $out

rule run_asan_test
  command = $builddir/asan/$name > $builddir/asan/$name.out && diff - tests/$name.expected < $builddir/asan/$name.out && echo "PASS(ASAN) $name"
  pool = console
  description = TEST(ASAN) $name

build $builddir/asan/rt/pal.o:      cc_rt_asan runtime/pal.c      | runtime/pal.h
build $builddir/asan/rt/pal_ctx.o:  as_obj     runtime/pal_ctx.S
build $builddir/asan/rt/arc.o:      cc_rt_asan runtime/arc.c      | runtime/arc.h runtime/pal.h runtime/fiber.h runtime/ocamlcc_bigarray.h runtime/ocamlcc_bigarray_types.h runtime/bigarray.inc
build $builddir/asan/rt/closure.o:  cc_rt_asan runtime/closure.c  | runtime/arc.h runtime/pal.h
build $builddir/asan/rt/fiber.o:    cc_rt_asan runtime/fiber.c    | runtime/fiber.h runtime/arc.h runtime/pal.h
build $builddir/asan/rt/builtins.o:   cc_rt_asan runtime/builtins.c
build $builddir/asan/rt/main_entry.o: cc_rt_asan runtime/main_entry.c

build $builddir/asan/rt/libocamlrt.a: ar $builddir/asan/rt/pal.o $builddir/asan/rt/pal_ctx.o $builddir/asan/rt/arc.o $builddir/asan/rt/closure.o $builddir/asan/rt/fiber.o $builddir/asan/rt/builtins.o $builddir/asan/rt/main_entry.o

build $builddir/asan/adt:           cc_link_asan $builddir/adt.s           $builddir/asan/rt/libocamlrt.a
build $builddir/asan/closures:      cc_link_asan $builddir/closures.s      $builddir/asan/rt/libocamlrt.a
build $builddir/asan/arrays_bytes:  cc_link_asan $builddir/arrays_bytes.s  $builddir/asan/rt/libocamlrt.a
build $builddir/asan/arc_test:      cc_link_asan $builddir/arc_test.s      $builddir/asan/rt/libocamlrt.a
build $builddir/asan/exn:           cc_link_asan $builddir/exn.s           $builddir/asan/rt/libocamlrt.a
build $builddir/asan/weak_cycle:    cc_link_asan $builddir/weak_cycle.s    $builddir/asan/rt/libocamlrt.a
build $builddir/asan/cycle_collect: cc_link_asan $builddir/cycle_collect.s $builddir/asan/rt/libocamlrt.a
build $builddir/asan/mod_main:      cc_link_asan $builddir/mod_main.s $builddir/mod_lib.s $builddir/asan/rt/libocamlrt.a
build $builddir/asan/stdlib_test:   cc_link_asan $builddir/stdlib_test.s   $stdlibdir/libocamlstdlib.a $builddir/asan/rt/libocamlrt.a
build $builddir/asan/fiber_test:    cc_link_asan $builddir/fiber_test.s    $stdlibdir/libocamlstdlib.a $builddir/asan/rt/libocamlrt.a
build $builddir/asan/fiber_io:      cc_link_asan $builddir/fiber_io.s      $stdlibdir/libocamlstdlib.a $builddir/asan/rt/libocamlrt.a

build asan_adt:           run_asan_test | $builddir/asan/adt
  name = adt
build asan_closures:      run_asan_test | $builddir/asan/closures
  name = closures
build asan_arrays_bytes:  run_asan_test | $builddir/asan/arrays_bytes
  name = arrays_bytes
build asan_arc_test:      run_asan_test | $builddir/asan/arc_test
  name = arc_test
build asan_exn:           run_asan_test | $builddir/asan/exn
  name = exn
build asan_weak_cycle:    run_asan_test | $builddir/asan/weak_cycle
  name = weak_cycle
build asan_cycle_collect: run_asan_test | $builddir/asan/cycle_collect
  name = cycle_collect
build asan_mod_main:      run_asan_test | $builddir/asan/mod_main
  name = mod_main
build asan_stdlib_test:   run_asan_test | $builddir/asan/stdlib_test
  name = stdlib_test
build asan_fiber_test:    run_asan_test | $builddir/asan/fiber_test
  name = fiber_test
build asan_fiber_io:      run_asan_test | $builddir/asan/fiber_io
  name = fiber_io

build $builddir/asan/mt_ffi_host: cc_link_asan tests/mt_ffi_host.c $builddir/mt_ffi_lib.s $stdlibdir/libocamlstdlib.a $builddir/asan/rt/libocamlrt.a | tests/mt_ffi_host.c

rule run_asan_mt_ffi
  command = $builddir/asan/mt_ffi_host > $builddir/asan/mt_ffi.out && diff - tests/mt_ffi.expected < $builddir/asan/mt_ffi.out && echo "PASS(ASAN) mt_ffi"
  pool = console
  description = TEST(ASAN) mt_ffi

build asan_mt_ffi: run_asan_mt_ffi | $builddir/asan/mt_ffi_host tests/mt_ffi.expected

build $builddir/asan/tupled_letrec: cc_link_asan $builddir/tupled_letrec.s $stdlibdir/libocamlstdlib.a $builddir/asan/rt/libocamlrt.a

build asan_tupled_letrec: run_asan_test | $builddir/asan/tupled_letrec
  name = tupled_letrec

build $builddir/asan/primitives_test: cc_link_asan $builddir/primitives_test.s $stdlibdir/libocamlstdlib.a $builddir/asan/rt/libocamlrt.a

build asan_primitives_test: run_asan_test | $builddir/asan/primitives_test
  name = primitives_test

rule cc_link_asan_bindgen
  command = $cc -std=c99 -fsanitize=address,undefined -fno-sanitize-recover=all -I$builddir tests/bindgen_host.c $builddir/bindgen_lib_shim.c $builddir/bindgen_lib.s $stdlibdir/libocamlstdlib.a $builddir/asan/rt/libocamlrt.a -lm -o $out
  description = LINK(ASAN) $out

build $builddir/asan/bindgen_host_bin: cc_link_asan_bindgen | $builddir/bindgen_lib.h $builddir/bindgen_lib_shim.c $builddir/bindgen_lib.s $stdlibdir/libocamlstdlib.a $builddir/asan/rt/libocamlrt.a tests/bindgen_host.c
rule run_asan_bindgen
  command = $builddir/asan/bindgen_host_bin > $builddir/asan/bindgen.out && diff - tests/bindgen_host.expected < $builddir/asan/bindgen.out && echo "PASS(ASAN) bindgen"
  pool = console
  description = TEST(ASAN) bindgen

build asan_bindgen: run_asan_bindgen | $builddir/asan/bindgen_host_bin tests/bindgen_host.expected

build $builddir/asan/stdlib_runtime: cc_link_asan tests/stdlib_runtime.c $builddir/asan/rt/libocamlrt.a
build asan_stdlib_runtime: run_asan_test | $builddir/asan/stdlib_runtime tests/stdlib_runtime.expected
  name = stdlib_runtime

build asan_test: phony asan_stdlib_runtime asan_adt asan_closures asan_arrays_bytes asan_arc_test asan_exn asan_weak_cycle asan_cycle_collect asan_mod_main asan_stdlib_test asan_fiber_test asan_fiber_io asan_mt_ffi asan_tupled_letrec asan_primitives_test asan_bindgen

rule run_stdlib_compat
  command = python3 tools/stdlib_compat.py && sh tests/stdlib_compat_opt.sh && python3 tools/stdlib_regressions.py && sh tests/bigarray_bindgen/run.sh
  description = TEST upstream stdlib compatibility
  pool = console

build stdlib_compat: run_stdlib_compat | $builddir/bin/ocamlcc $builddir/qbe/qbe $builddir/rt/libocamlrt.a

default $builddir/qbe/qbe $builddir/rt/libocamlrt.a $stdlibdir/libocamlstdlib.a.opt $builddir/bin/ocamlcc $builddir/hello

# ThreadSanitizer variant: C11 data-race detection for the concurrent runtime.
rule cc_rt_tsan
  command = $cc $rt_cflags -O1 -fsanitize=thread -fno-omit-frame-pointer -Iruntime -c $in -o $out
  description = CC(TSAN) $out

rule cc_link_tsan
  command = $cc -fsanitize=thread -pthread $in -lm -o $out
  description = LINK(TSAN) $out

build $builddir/tsan/rt/pal.o:        cc_rt_tsan runtime/pal.c      | runtime/pal.h
build $builddir/tsan/rt/pal_ctx.o:    as_obj     runtime/pal_ctx.S
build $builddir/tsan/rt/arc.o:        cc_rt_tsan runtime/arc.c      | runtime/arc.h runtime/pal.h runtime/fiber.h runtime/ocamlcc_bigarray.h runtime/ocamlcc_bigarray_types.h runtime/bigarray.inc
build $builddir/tsan/rt/closure.o:    cc_rt_tsan runtime/closure.c  | runtime/arc.h runtime/pal.h
build $builddir/tsan/rt/fiber.o:      cc_rt_tsan runtime/fiber.c    | runtime/fiber.h runtime/arc.h runtime/pal.h
build $builddir/tsan/rt/builtins.o:   cc_rt_tsan runtime/builtins.c
build $builddir/tsan/rt/main_entry.o: cc_rt_tsan runtime/main_entry.c

build $builddir/tsan/rt/libocamlrt.a: ar $builddir/tsan/rt/pal.o $builddir/tsan/rt/pal_ctx.o $builddir/tsan/rt/arc.o $builddir/tsan/rt/closure.o $builddir/tsan/rt/fiber.o $builddir/tsan/rt/builtins.o $builddir/tsan/rt/main_entry.o

build $builddir/tsan/cc_reserved_race: cc_link_tsan tests/cc_reserved_race.c $builddir/tsan/rt/libocamlrt.a | tests/cc_reserved_race.c
build $builddir/tsan/mt_ffi_host: cc_link_tsan tests/mt_ffi_host.c $builddir/mt_ffi_lib.s $stdlibdir/libocamlstdlib.a $builddir/tsan/rt/libocamlrt.a | tests/mt_ffi_host.c

rule run_tsan_test
  command = $builddir/tsan/$name > $builddir/tsan/$name.out 2>&1 && diff - tests/$name.expected < $builddir/tsan/$name.out && echo "PASS(TSAN) $name"
  pool = console
  description = TEST(TSAN) $name

rule run_tsan_mt_ffi
  command = $builddir/tsan/mt_ffi_host > $builddir/tsan/mt_ffi.out 2>&1 && diff - tests/mt_ffi.expected < $builddir/tsan/mt_ffi.out && echo "PASS(TSAN) mt_ffi"
  pool = console
  description = TEST(TSAN) mt_ffi

build tsan_cc_reserved_race: run_tsan_test | $builddir/tsan/cc_reserved_race tests/cc_reserved_race.expected
  name = cc_reserved_race
build tsan_mt_ffi: run_tsan_mt_ffi | $builddir/tsan/mt_ffi_host tests/mt_ffi.expected

build tsan_test: phony tsan_cc_reserved_race tsan_mt_ffi

rule run_bootstrap
  command = python3 tools/bootstrap.py --stage $stage
  description = BOOTSTRAP ($stage)
  pool = console

build bootstrap_fetch: run_bootstrap
  stage = fetch
build bootstrap_stage1: run_bootstrap | $builddir/bin/ocamlcc $builddir/qbe/qbe $builddir/rt/libocamlrt.a
  stage = stage1
build bootstrap: run_bootstrap | $builddir/bin/ocamlcc $builddir/qbe/qbe $builddir/rt/libocamlrt.a
  stage = all
