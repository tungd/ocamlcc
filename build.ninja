# ocamlcc top-level build pipeline (ninja).
#
#   1. vendor/qbe  -> build/qbe/qbe
#   2. runtime/    -> build/rt/libocamlrt.a
#   3. dune        -> build/bin/ocamlcc
#   4. examples/*.ml -> .ssa (ocamlcc) -> .s (qbe) -> native executable (cc)

builddir = build
cc = cc
qbe_dir = vendor/qbe

qbe_cflags = -std=c99 -O2 -g -Wall -Wextra -Wpedantic
rt_cflags = -std=c11 -O2 -g -fPIC -Wall -Wextra

rule cc_qbe
  command = $cc $qbe_cflags -c $in -o $out -I$builddir/qbe
  description = CC $out

rule gen_config
  command = sh tools/gen-config.sh > $out
  description = GEN $out

rule link_qbe
  command = $cc $in -o $out
  description = LINK $out

rule cc_rt
  command = $cc $rt_cflags -Iruntime -c $in -o $out
  description = CC $out

rule ar
  command = ar rcs $out $in
  description = AR $out

rule dune_ocamlcc
  command = dune build bin/ocamlcc && mkdir -p $builddir/bin && rm -f $out && cp _build/default/bin/ocamlcc $out
  description = DUNE ocamlcc
  pool = console

rule ocamlcc_cmi
  command = $builddir/bin/ocamlcc compile-mli $flags $in -o $out
  description = CMIC $out

rule ocamlcc_ssa
  command = $builddir/bin/ocamlcc compile $flags $in -o $out
  description = OCAMLCC $out

rule qbe_ssa
  command = $builddir/qbe/qbe $in > $out
  description = QBE $out

rule cc_link
  command = $cc -pthread $in -lm -o $out
  description = LINK $out

rule as_obj
  command = $cc -c $in -o $out
  description = AS $out

rule run
  command = $in && echo "--- smoke: $in OK"
  pool = console
  description = RUN $in

# ---------------------------------------------------------------- QBE ----

qbe_common = main util parse abi cfg mem ssa alias load copy fold gvn gcm simpl ifopt live spill rega emit

build $builddir/qbe/config.h: gen_config

build $builddir/qbe/main.o:    cc_qbe $qbe_dir/main.c    | $qbe_dir/all.h $qbe_dir/ops.h $builddir/qbe/config.h
build $builddir/qbe/util.o:    cc_qbe $qbe_dir/util.c    | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/parse.o:   cc_qbe $qbe_dir/parse.c   | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/abi.o:     cc_qbe $qbe_dir/abi.c     | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/cfg.o:     cc_qbe $qbe_dir/cfg.c     | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/mem.o:     cc_qbe $qbe_dir/mem.c     | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/ssa.o:     cc_qbe $qbe_dir/ssa.c     | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/alias.o:   cc_qbe $qbe_dir/alias.c   | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/load.o:    cc_qbe $qbe_dir/load.c    | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/copy.o:    cc_qbe $qbe_dir/copy.c    | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/fold.o:    cc_qbe $qbe_dir/fold.c    | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/gvn.o:     cc_qbe $qbe_dir/gvn.c     | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/gcm.o:     cc_qbe $qbe_dir/gcm.c     | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/simpl.o:   cc_qbe $qbe_dir/simpl.c   | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/ifopt.o:   cc_qbe $qbe_dir/ifopt.c   | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/live.o:    cc_qbe $qbe_dir/live.c    | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/spill.o:   cc_qbe $qbe_dir/spill.c   | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/rega.o:    cc_qbe $qbe_dir/rega.c    | $qbe_dir/all.h $qbe_dir/ops.h
build $builddir/qbe/emit.o:    cc_qbe $qbe_dir/emit.c    | $qbe_dir/all.h $qbe_dir/ops.h

build $builddir/qbe/amd64/targ.o:   cc_qbe $qbe_dir/amd64/targ.c   | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/amd64/all.h
build $builddir/qbe/amd64/sysv.o:   cc_qbe $qbe_dir/amd64/sysv.c   | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/amd64/all.h
build $builddir/qbe/amd64/isel.o:   cc_qbe $qbe_dir/amd64/isel.c   | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/amd64/all.h
build $builddir/qbe/amd64/emit.o:   cc_qbe $qbe_dir/amd64/emit.c   | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/amd64/all.h
build $builddir/qbe/amd64/winabi.o: cc_qbe $qbe_dir/amd64/winabi.c | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/amd64/all.h

build $builddir/qbe/arm64/targ.o: cc_qbe $qbe_dir/arm64/targ.c | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/arm64/all.h
build $builddir/qbe/arm64/abi.o:  cc_qbe $qbe_dir/arm64/abi.c  | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/arm64/all.h
build $builddir/qbe/arm64/isel.o: cc_qbe $qbe_dir/arm64/isel.c | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/arm64/all.h
build $builddir/qbe/arm64/emit.o: cc_qbe $qbe_dir/arm64/emit.c | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/arm64/all.h

build $builddir/qbe/rv64/targ.o: cc_qbe $qbe_dir/rv64/targ.c | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/rv64/all.h
build $builddir/qbe/rv64/abi.o:  cc_qbe $qbe_dir/rv64/abi.c  | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/rv64/all.h
build $builddir/qbe/rv64/isel.o: cc_qbe $qbe_dir/rv64/isel.c | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/rv64/all.h
build $builddir/qbe/rv64/emit.o: cc_qbe $qbe_dir/rv64/emit.c | $qbe_dir/all.h $qbe_dir/ops.h $qbe_dir/rv64/all.h

build $builddir/qbe/qbe: link_qbe $builddir/qbe/main.o $builddir/qbe/util.o $builddir/qbe/parse.o $builddir/qbe/abi.o $builddir/qbe/cfg.o $builddir/qbe/mem.o $builddir/qbe/ssa.o $builddir/qbe/alias.o $builddir/qbe/load.o $builddir/qbe/copy.o $builddir/qbe/fold.o $builddir/qbe/gvn.o $builddir/qbe/gcm.o $builddir/qbe/simpl.o $builddir/qbe/ifopt.o $builddir/qbe/live.o $builddir/qbe/spill.o $builddir/qbe/rega.o $builddir/qbe/emit.o $builddir/qbe/amd64/targ.o $builddir/qbe/amd64/sysv.o $builddir/qbe/amd64/isel.o $builddir/qbe/amd64/emit.o $builddir/qbe/amd64/winabi.o $builddir/qbe/arm64/targ.o $builddir/qbe/arm64/abi.o $builddir/qbe/arm64/isel.o $builddir/qbe/arm64/emit.o $builddir/qbe/rv64/targ.o $builddir/qbe/rv64/abi.o $builddir/qbe/rv64/isel.o $builddir/qbe/rv64/emit.o

# ------------------------------------------------------------ runtime ----

build $builddir/rt/pal.o:      cc_rt runtime/pal.c      | runtime/pal.h
build $builddir/rt/pal_ctx.o:  as_obj runtime/pal_ctx.S
build $builddir/rt/arc.o:      cc_rt runtime/arc.c      | runtime/arc.h runtime/pal.h runtime/fiber.h runtime/ocamlcc_bigarray.h runtime/ocamlcc_bigarray_types.h runtime/bigarray.inc
build $builddir/rt/closure.o:  cc_rt runtime/closure.c  | runtime/arc.h runtime/pal.h
build $builddir/rt/fiber.o:    cc_rt runtime/fiber.c    | runtime/fiber.h runtime/arc.h runtime/pal.h
build $builddir/rt/builtins.o:   cc_rt runtime/builtins.c
build $builddir/rt/main_entry.o: cc_rt runtime/main_entry.c

build $builddir/rt/libocamlrt.a: ar $builddir/rt/pal.o $builddir/rt/pal_ctx.o $builddir/rt/arc.o $builddir/rt/closure.o $builddir/rt/fiber.o $builddir/rt/builtins.o $builddir/rt/main_entry.o

# Optional single-OS-thread runtime. Only arc.o differs from the default.
rule cc_rt_single
  command = $cc $rt_cflags -DOCAMLCC_SINGLE_THREAD_RC -Iruntime -c $in -o $out
  description = CC(SINGLE-THREAD) $out

rule copy_rt_single
  command = cp $in $builddir/rt-single/
  description = STAGE single-thread runtime objects

build $builddir/rt-single/arc.o: cc_rt_single runtime/arc.c | runtime/arc.h runtime/pal.h runtime/fiber.h runtime/ocamlcc_bigarray.h runtime/ocamlcc_bigarray_types.h runtime/bigarray.inc
build $builddir/rt-single/pal.o $builddir/rt-single/pal_ctx.o $builddir/rt-single/closure.o $builddir/rt-single/fiber.o $builddir/rt-single/builtins.o $builddir/rt-single/main_entry.o: copy_rt_single $builddir/rt/pal.o $builddir/rt/pal_ctx.o $builddir/rt/closure.o $builddir/rt/fiber.o $builddir/rt/builtins.o $builddir/rt/main_entry.o
build $builddir/rt-single/libocamlrt.a: ar $builddir/rt-single/arc.o $builddir/rt-single/pal.o $builddir/rt-single/pal_ctx.o $builddir/rt-single/closure.o $builddir/rt-single/fiber.o $builddir/rt-single/builtins.o $builddir/rt-single/main_entry.o
build single_thread_runtime: phony $builddir/rt-single/libocamlrt.a

# ------------------------------------------------------------- ocamlcc ----

build $builddir/bin/ocamlcc: dune_ocamlcc runtime/ocamlcc_bigarray_types.h bin/main.ml lib/qbe_il.ml lib/qbe_il.mli lib/frontend.ml lib/frontend.mli lib/builtins.ml lib/builtins.mli lib/anf.ml lib/anf.mli lib/anf_ir.ml lib/anf_ir.mli lib/anf_scalar.ml lib/anf_scalar.mli lib/lambda_opt.ml lib/lambda_opt.mli lib/bounds.ml lib/bounds.mli lib/arc_analysis.ml lib/arc_analysis.mli lib/arc_views.ml lib/arc_views.mli lib/arc_pass.ml lib/arc_pass.mli lib/ccalls.ml lib/ccalls.mli lib/c_bindgen.ml lib/c_bindgen.mli lib/driver.ml lib/driver.mli lib/export_summary.ml lib/export_summary.mli lib/codegen_ctx.ml lib/codegen_analysis.ml lib/codegen_expr.ml lib/codegen_fn.ml lib/codegen.ml lib/codegen.mli lib/pipeline.ml lib/pipeline.mli lib/sys_util.ml lib/sys_util.mli lib/dune bin/dune dune-project

# ------------------------------------------------------------- stdlib -----

stdlibdir = $builddir/stdlib
stdlib_flags = --nostdlib --nopervasives --mod --emit-opt -I $stdlibdir

build $stdlibdir/camlinternalFormatBasics.ssa | $stdlibdir/camlinternalFormatBasics.cmi $stdlibdir/camlinternalFormatBasics.opt: ocamlcc_ssa stdlib/camlinternalFormatBasics.ml | $builddir/bin/ocamlcc
  flags = $stdlib_flags --cmi-prefix $stdlibdir/camlinternalFormatBasics
build $stdlibdir/camlinternalFormatBasics.s: qbe_ssa $stdlibdir/camlinternalFormatBasics.ssa | $builddir/qbe/qbe
build $stdlibdir/camlinternalFormatBasics.o: as_obj $stdlibdir/camlinternalFormatBasics.s

build $stdlibdir/camlinternalIntFmt.ssa | $stdlibdir/camlinternalIntFmt.cmi $stdlibdir/camlinternalIntFmt.opt: ocamlcc_ssa stdlib/camlinternalIntFmt.ml | $builddir/bin/ocamlcc
  flags = $stdlib_flags --cmi-prefix $stdlibdir/camlinternalIntFmt
build $stdlibdir/camlinternalIntFmt.s: qbe_ssa $stdlibdir/camlinternalIntFmt.ssa | $builddir/qbe/qbe
build $stdlibdir/camlinternalIntFmt.o: as_obj $stdlibdir/camlinternalIntFmt.s

build $stdlibdir/camlinternalBulkOps.ssa | $stdlibdir/camlinternalBulkOps.cmi $stdlibdir/camlinternalBulkOps.opt: ocamlcc_ssa stdlib/camlinternalBulkOps.ml | $builddir/bin/ocamlcc
  flags = $stdlib_flags --cmi-prefix $stdlibdir/camlinternalBulkOps
build $stdlibdir/camlinternalBulkOps.s: qbe_ssa $stdlibdir/camlinternalBulkOps.ssa | $builddir/qbe/qbe
build $stdlibdir/camlinternalBulkOps.o: as_obj $stdlibdir/camlinternalBulkOps.s

build $stdlibdir/camlinternalChannel.ssa | $stdlibdir/camlinternalChannel.cmi $stdlibdir/camlinternalChannel.opt: ocamlcc_ssa stdlib/camlinternalChannel.ml | $builddir/bin/ocamlcc $stdlibdir/camlinternalBulkOps.cmi
  flags = $stdlib_flags --cmi-prefix $stdlibdir/camlinternalChannel
build $stdlibdir/camlinternalChannel.s: qbe_ssa $stdlibdir/camlinternalChannel.ssa | $builddir/qbe/qbe
build $stdlibdir/camlinternalChannel.o: as_obj $stdlibdir/camlinternalChannel.s

build $stdlibdir/camlinternalMarshal.ssa | $stdlibdir/camlinternalMarshal.cmi $stdlibdir/camlinternalMarshal.opt: ocamlcc_ssa stdlib/camlinternalMarshal.ml | $builddir/bin/ocamlcc $stdlibdir/camlinternalBulkOps.cmi $stdlibdir/camlinternalChannel.cmi
  flags = $stdlib_flags --cmi-prefix $stdlibdir/camlinternalMarshal
build $stdlibdir/camlinternalMarshal.s: qbe_ssa $stdlibdir/camlinternalMarshal.ssa | $builddir/qbe/qbe
build $stdlibdir/camlinternalMarshal.o: as_obj $stdlibdir/camlinternalMarshal.s

build $stdlibdir/camlinternalSys.ssa | $stdlibdir/camlinternalSys.cmi $stdlibdir/camlinternalSys.opt: ocamlcc_ssa stdlib/camlinternalSys.ml | $builddir/bin/ocamlcc
  flags = $stdlib_flags --cmi-prefix $stdlibdir/camlinternalSys
build $stdlibdir/camlinternalSys.s: qbe_ssa $stdlibdir/camlinternalSys.ssa | $builddir/qbe/qbe
build $stdlibdir/camlinternalSys.o: as_obj $stdlibdir/camlinternalSys.s

build $stdlibdir/stdlib__option.ssa | $stdlibdir/stdlib__option.cmi $stdlibdir/stdlib__option.opt: ocamlcc_ssa stdlib/stdlib__option.ml | $builddir/bin/ocamlcc
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__option
build $stdlibdir/stdlib__option.s: qbe_ssa $stdlibdir/stdlib__option.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__option.o: as_obj $stdlibdir/stdlib__option.s

build $stdlibdir/stdlib__result.ssa | $stdlibdir/stdlib__result.cmi $stdlibdir/stdlib__result.opt: ocamlcc_ssa stdlib/stdlib__result.ml | $builddir/bin/ocamlcc
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__result
build $stdlibdir/stdlib__result.s: qbe_ssa $stdlibdir/stdlib__result.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__result.o: as_obj $stdlibdir/stdlib__result.s

build $stdlibdir/stdlib__bytes.ssa | $stdlibdir/stdlib__bytes.cmi $stdlibdir/stdlib__bytes.opt: ocamlcc_ssa stdlib/stdlib__bytes.ml | $builddir/bin/ocamlcc $stdlibdir/camlinternalBulkOps.cmi
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__bytes
build $stdlibdir/stdlib__bytes.s: qbe_ssa $stdlibdir/stdlib__bytes.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__bytes.o: as_obj $stdlibdir/stdlib__bytes.s

build $stdlibdir/stdlib__string.ssa | $stdlibdir/stdlib__string.cmi $stdlibdir/stdlib__string.opt: ocamlcc_ssa stdlib/stdlib__string.ml | $builddir/bin/ocamlcc $stdlibdir/camlinternalBulkOps.cmi $stdlibdir/stdlib__bytes.cmi
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__string
build $stdlibdir/stdlib__string.s: qbe_ssa $stdlibdir/stdlib__string.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__string.o: as_obj $stdlibdir/stdlib__string.s

build $stdlibdir/stdlib__list.ssa | $stdlibdir/stdlib__list.cmi $stdlibdir/stdlib__list.opt: ocamlcc_ssa stdlib/stdlib__list.ml | $builddir/bin/ocamlcc
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__list
build $stdlibdir/stdlib__list.s: qbe_ssa $stdlibdir/stdlib__list.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__list.o: as_obj $stdlibdir/stdlib__list.s

build $stdlibdir/stdlib__array.ssa | $stdlibdir/stdlib__array.cmi $stdlibdir/stdlib__array.opt: ocamlcc_ssa stdlib/stdlib__array.ml | $builddir/bin/ocamlcc $stdlibdir/camlinternalBulkOps.cmi $stdlibdir/stdlib__list.cmi
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__array
build $stdlibdir/stdlib__array.s: qbe_ssa $stdlibdir/stdlib__array.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__array.o: as_obj $stdlibdir/stdlib__array.s

build $stdlibdir/stdlib__buffer.ssa | $stdlibdir/stdlib__buffer.cmi $stdlibdir/stdlib__buffer.opt: ocamlcc_ssa stdlib/stdlib__buffer.ml | $builddir/bin/ocamlcc $stdlibdir/stdlib__bytes.cmi $stdlibdir/stdlib__string.cmi
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__buffer
build $stdlibdir/stdlib__buffer.s: qbe_ssa $stdlibdir/stdlib__buffer.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__buffer.o: as_obj $stdlibdir/stdlib__buffer.s

build $stdlibdir/stdlib__hashtbl.ssa | $stdlibdir/stdlib__hashtbl.cmi $stdlibdir/stdlib__hashtbl.opt: ocamlcc_ssa stdlib/stdlib__hashtbl.ml | $builddir/bin/ocamlcc $stdlibdir/stdlib__array.cmi
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__hashtbl
build $stdlibdir/stdlib__hashtbl.s: qbe_ssa $stdlibdir/stdlib__hashtbl.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__hashtbl.o: as_obj $stdlibdir/stdlib__hashtbl.s

build $stdlibdir/stdlib__printf.ssa | $stdlibdir/stdlib__printf.cmi $stdlibdir/stdlib__printf.opt: ocamlcc_ssa stdlib/stdlib__printf.ml | $builddir/bin/ocamlcc $stdlibdir/camlinternalFormatBasics.cmi $stdlibdir/camlinternalIntFmt.cmi $stdlibdir/stdlib__bytes.cmi $stdlibdir/stdlib__string.cmi $stdlibdir/stdlib__list.cmi $stdlibdir/stdlib__buffer.cmi
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__printf
build $stdlibdir/stdlib__printf.s: qbe_ssa $stdlibdir/stdlib__printf.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__printf.o: as_obj $stdlibdir/stdlib__printf.s

build $stdlibdir/stdlib__weak.ssa | $stdlibdir/stdlib__weak.cmi $stdlibdir/stdlib__weak.opt: ocamlcc_ssa stdlib/stdlib__weak.ml | $builddir/bin/ocamlcc
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__weak
build $stdlibdir/stdlib__weak.s: qbe_ssa $stdlibdir/stdlib__weak.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__weak.o: as_obj $stdlibdir/stdlib__weak.s

build $stdlibdir/stdlib__fiber.ssa | $stdlibdir/stdlib__fiber.cmi $stdlibdir/stdlib__fiber.opt: ocamlcc_ssa stdlib/stdlib__fiber.ml | $builddir/bin/ocamlcc
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__fiber
build $stdlibdir/stdlib__fiber.s: qbe_ssa $stdlibdir/stdlib__fiber.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__fiber.o: as_obj $stdlibdir/stdlib__fiber.s

build $stdlibdir/stdlib__int32.ssa | $stdlibdir/stdlib__int32.cmi $stdlibdir/stdlib__int32.opt: ocamlcc_ssa stdlib/stdlib__int32.ml | $builddir/bin/ocamlcc $stdlibdir/camlinternalIntFmt.cmi
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__int32
build $stdlibdir/stdlib__int32.s: qbe_ssa $stdlibdir/stdlib__int32.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__int32.o: as_obj $stdlibdir/stdlib__int32.s

build $stdlibdir/stdlib__int64.ssa | $stdlibdir/stdlib__int64.cmi $stdlibdir/stdlib__int64.opt: ocamlcc_ssa stdlib/stdlib__int64.ml | $builddir/bin/ocamlcc $stdlibdir/camlinternalIntFmt.cmi
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__int64
build $stdlibdir/stdlib__int64.s: qbe_ssa $stdlibdir/stdlib__int64.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__int64.o: as_obj $stdlibdir/stdlib__int64.s

build $stdlibdir/stdlib__nativeint.ssa | $stdlibdir/stdlib__nativeint.cmi $stdlibdir/stdlib__nativeint.opt: ocamlcc_ssa stdlib/stdlib__nativeint.ml | $builddir/bin/ocamlcc $stdlibdir/camlinternalIntFmt.cmi
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib__nativeint
build $stdlibdir/stdlib__nativeint.s: qbe_ssa $stdlibdir/stdlib__nativeint.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib__nativeint.o: as_obj $stdlibdir/stdlib__nativeint.s

build $stdlibdir/stdlib.ssa | $stdlibdir/stdlib.cmi $stdlibdir/stdlib.opt: ocamlcc_ssa stdlib/stdlib.ml | $builddir/bin/ocamlcc $stdlibdir/camlinternalFormatBasics.cmi $stdlibdir/camlinternalIntFmt.cmi $stdlibdir/camlinternalBulkOps.cmi $stdlibdir/camlinternalChannel.cmi $stdlibdir/camlinternalMarshal.cmi $stdlibdir/camlinternalSys.cmi $stdlibdir/stdlib__option.cmi $stdlibdir/stdlib__result.cmi $stdlibdir/stdlib__int32.cmi $stdlibdir/stdlib__int64.cmi $stdlibdir/stdlib__nativeint.cmi $stdlibdir/stdlib__bytes.cmi $stdlibdir/stdlib__string.cmi $stdlibdir/stdlib__list.cmi $stdlibdir/stdlib__array.cmi $stdlibdir/stdlib__buffer.cmi $stdlibdir/stdlib__hashtbl.cmi $stdlibdir/stdlib__printf.cmi $stdlibdir/stdlib__weak.cmi $stdlibdir/stdlib__fiber.cmi
  flags = $stdlib_flags --cmi-prefix $stdlibdir/stdlib
build $stdlibdir/stdlib.s: qbe_ssa $stdlibdir/stdlib.ssa | $builddir/qbe/qbe
build $stdlibdir/stdlib.o: as_obj $stdlibdir/stdlib.s

build $stdlibdir/libocamlstdlib.a: ar $stdlibdir/camlinternalFormatBasics.o $stdlibdir/camlinternalIntFmt.o $stdlibdir/camlinternalBulkOps.o $stdlibdir/camlinternalChannel.o $stdlibdir/camlinternalMarshal.o $stdlibdir/camlinternalSys.o $stdlibdir/stdlib__option.o $stdlibdir/stdlib__result.o $stdlibdir/stdlib__int32.o $stdlibdir/stdlib__int64.o $stdlibdir/stdlib__nativeint.o $stdlibdir/stdlib__bytes.o $stdlibdir/stdlib__string.o $stdlibdir/stdlib__list.o $stdlibdir/stdlib__array.o $stdlibdir/stdlib__buffer.o $stdlibdir/stdlib__hashtbl.o $stdlibdir/stdlib__printf.o $stdlibdir/stdlib__weak.o $stdlibdir/stdlib__fiber.o $stdlibdir/stdlib.o

rule archive_opt
  command = $builddir/bin/ocamlcc archive-opt $in
  description = OPT $out

build $stdlibdir/libocamlstdlib.a.opt | $stdlibdir/camlinternalFormatBasics.exports $stdlibdir/camlinternalIntFmt.exports $stdlibdir/camlinternalBulkOps.exports $stdlibdir/camlinternalChannel.exports $stdlibdir/camlinternalMarshal.exports $stdlibdir/camlinternalSys.exports $stdlibdir/stdlib__option.exports $stdlibdir/stdlib__result.exports $stdlibdir/stdlib__int32.exports $stdlibdir/stdlib__int64.exports $stdlibdir/stdlib__nativeint.exports $stdlibdir/stdlib__bytes.exports $stdlibdir/stdlib__string.exports $stdlibdir/stdlib__list.exports $stdlibdir/stdlib__array.exports $stdlibdir/stdlib__buffer.exports $stdlibdir/stdlib__hashtbl.exports $stdlibdir/stdlib__printf.exports $stdlibdir/stdlib__weak.exports $stdlibdir/stdlib__fiber.exports $stdlibdir/stdlib.exports: archive_opt $stdlibdir/libocamlstdlib.a $stdlibdir/camlinternalFormatBasics.opt $stdlibdir/camlinternalIntFmt.opt $stdlibdir/camlinternalBulkOps.opt $stdlibdir/camlinternalChannel.opt $stdlibdir/camlinternalMarshal.opt $stdlibdir/camlinternalSys.opt $stdlibdir/stdlib__option.opt $stdlibdir/stdlib__result.opt $stdlibdir/stdlib__int32.opt $stdlibdir/stdlib__int64.opt $stdlibdir/stdlib__nativeint.opt $stdlibdir/stdlib__bytes.opt $stdlibdir/stdlib__string.opt $stdlibdir/stdlib__list.opt $stdlibdir/stdlib__array.opt $stdlibdir/stdlib__buffer.opt $stdlibdir/stdlib__hashtbl.opt $stdlibdir/stdlib__printf.opt $stdlibdir/stdlib__weak.opt $stdlibdir/stdlib__fiber.opt $stdlibdir/stdlib.opt | $builddir/bin/ocamlcc


# ------------------------------------------------------------ examples ----

rule run_test
  command = $builddir/$name > $builddir/$name.out && diff - tests/$name.expected < $builddir/$name.out && echo "PASS $name"
  pool = console
  description = TEST $name

build $builddir/hello.ssa: ocamlcc_ssa examples/hello.ml | $builddir/bin/ocamlcc
build $builddir/hello.s: qbe_ssa $builddir/hello.ssa | $builddir/qbe/qbe
