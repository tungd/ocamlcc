(executable
 (public_name occ)
 (package ocamlcc)
 (name main)
 (modules main)
 (libraries ocamlcc))

(rule
 (alias default)
 (action (copy main.exe occ)))

(rule
 (alias default)
 (action (copy occ ocamlcc)))


(executable
 (public_name ocpkg)
 (package ocamlcc)
 (name ocpkg_main)
 (modules ocpkg_main ocpkg_version)
 (libraries ocamlcc ocpkg_core ocpkg_http)
 (foreign_stubs (language c) (names ocpkg_curl))
 (link_flags (:include curl_link_flags.sexp)))

(rule
 (target curl_link_flags.sexp)
 (action
  (with-stdout-to %{target}
   (run sh %{dep:../tools/curl-link-flags.sh}))))


(rule
 (target ocpkg_version.ml)
 (deps ../ocamlcc.opam)
 (action (with-stdout-to %{target}
  (echo "let value = \"%{version:ocamlcc}\""))))
