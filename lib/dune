(library
 (name ocamlcc)
 (wrapped false)
 (modules (:standard \ sha256 ocpkg_format pkg_archive pkg_vendor pkg_project http_fetch build_cache pkg_toolchain pkg_compile workspace))
 (libraries compiler-libs.common unix))

;; Keep standalone generated C headers in sync with the runtime view ABI.
(rule
 (target bigarray_header.ml)
 (deps ../runtime/ocamlcc_bigarray_types.h)
 (action
  (with-stdout-to %{target}
   (progn
    (echo "let contents = {|")
    (cat %{deps})
    (echo "|}")))))

(library
 (name ocpkg_core)
 (wrapped false)
 (modules sha256 ocpkg_format pkg_archive pkg_vendor pkg_project build_cache pkg_toolchain pkg_compile workspace)
 (libraries ocamlcc unix))


(library
 (name ocpkg_http)
 (wrapped false)
 (modules http_fetch))
