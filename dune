;; Generated build artifacts may contain vendored projects with their own dune
;; files. They belong to the package executor, not this compiler's workspace.
(dirs :standard \ build)

;; Private compiler inputs used for native and cross builds.
(install
 (section lib_root)
 (files
  (runtime/arc.c as occ/rt-src/arc.c)
  (runtime/arc_internal.h as occ/rt-src/arc_internal.h)
  (runtime/slab.c as occ/rt-src/slab.c)
  (runtime/cycle.c as occ/rt-src/cycle.c)
  (runtime/weak.c as occ/rt-src/weak.c)
  (runtime/primitives.c as occ/rt-src/primitives.c)
  (runtime/arc.h as occ/rt-src/arc.h)
  (runtime/ocamlcc_bigarray_types.h as occ/rt-src/ocamlcc_bigarray_types.h)
  (runtime/ocamlcc_bigarray.h as occ/rt-src/ocamlcc_bigarray.h)
  (runtime/bigarray.inc as occ/rt-src/bigarray.inc)
  (runtime/builtins.c as occ/rt-src/builtins.c)
  (runtime/closure.c as occ/rt-src/closure.c)
  (runtime/fiber.c as occ/rt-src/fiber.c)
  (runtime/fiber.h as occ/rt-src/fiber.h)
  (runtime/main_entry.c as occ/rt-src/main_entry.c)
  (runtime/pal.c as occ/rt-src/pal.c)
  (runtime/pal.h as occ/rt-src/pal.h)
  (runtime/pal_ctx.S as occ/rt-src/pal_ctx.S)
  (stdlib.sources as occ/stdlib-src/stdlib.sources)
  (packages/snapshots/default.snap as occ/snapshots/default.snap)
  (packages/ports/crunch-unix/unix.ml as occ/ports/crunch-unix/unix.ml)
  (packages/ports/crunch-unix/unix.mli as occ/ports/crunch-unix/unix.mli)
  (packages/ports/crunch-unix/unix_stubs.c as occ/ports/crunch-unix/unix_stubs.c)))

(rule
 (target stdlib.sources)
 (deps tools/stdlib_compat.py vendor/ocaml-stdlib/src/.depend
  (source_tree vendor/ocaml-stdlib/src) (source_tree stdlib))
 (action (run python3 tools/stdlib_compat.py --source-bundle %{target})))
