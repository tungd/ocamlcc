;; Generated build artifacts may contain vendored projects with their own dune
;; files. They belong to the package executor, not this compiler's workspace.
(dirs :standard \ build)

;; Private compiler inputs used for native and cross builds.
(install
 (section lib)
 (files
  (runtime/arc.c as runtime/arc.c)
  (runtime/arc_internal.h as runtime/arc_internal.h)
  (runtime/slab.c as runtime/slab.c)
  (runtime/cycle.c as runtime/cycle.c)
  (runtime/weak.c as runtime/weak.c)
  (runtime/primitives.c as runtime/primitives.c)
  (runtime/arc.h as runtime/arc.h)
  (runtime/ocamlcc_bigarray_types.h as runtime/ocamlcc_bigarray_types.h)
  (runtime/ocamlcc_bigarray.h as runtime/ocamlcc_bigarray.h)
  (runtime/bigarray.inc as runtime/bigarray.inc)
  (runtime/builtins.c as runtime/builtins.c)
  (runtime/closure.c as runtime/closure.c)
  (runtime/fiber.c as runtime/fiber.c)
  (runtime/fiber.h as runtime/fiber.h)
  (runtime/main_entry.c as runtime/main_entry.c)
  (runtime/pal.c as runtime/pal.c)
  (runtime/pal.h as runtime/pal.h)
  (runtime/pal_ctx.S as runtime/pal_ctx.S)
  (stdlib.sources as stdlib/stdlib.sources)))

(rule
 (target stdlib.sources)
 (deps tools/stdlib_compat.py vendor/ocaml-stdlib/src/.depend
  (source_tree vendor/ocaml-stdlib/src) (source_tree stdlib))
 (action (run python3 tools/stdlib_compat.py --source-bundle %{target})))
